# Example env file for ILC (do NOT commit secrets)
# Copy to .env and fill values before running in production

# Database
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJ.supabase.co:5432/postgres

# Supabase public URL (used by frontend at build time)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Secrets (keep different values and store in secret manager)
JWT_SECRET=replace_with_a_strong_random_string
SESSION_SECRET=replace_with_a_strong_random_string
SERVICE_ROLE_SUPABASE=replace_with_service_role_key

# Google OAuth (set in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# App
PORT=3000
NODE_ENV=production
